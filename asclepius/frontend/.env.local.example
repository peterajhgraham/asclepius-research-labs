# Backend URL, read server-side by the Next.js API proxy routes.
# On Vercel set this to your Railway URL; if it is missing every query falls back to
# http://localhost:8000 and fails with "Backend unreachable".
API_URL=http://localhost:8000

# Clerk authentication (optional, leave blank to disable auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
