# Required: inference. GET /health shows "llm": "missing_api_key" until this is set.
ANTHROPIC_API_KEY=

# Optional: raises the PubMed rate limit from 3 to 10 requests/s
NCBI_API_KEY=

DAILY_BUDGET_USD=10.00
DATABASE_URL=sqlite+aiosqlite:///./data/asclepius.db

# Seconds a query waits for the retrieval index to finish building
RETRIEVAL_WAIT_SECONDS=20
